{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      matchDatasources: [
        "docker"
      ],
      matchPackageNames: [
        "ghcr.io/home-operations/plex"
      ],
      versioning: "loose"
    },
    {
      matchDatasources: [
        "docker"
      ],
      matchPackageNames: [
        "ghcr.io/tensorchord/vchord-scratch"
      ],
      versioning: "regex:^pg(?<compatibility>\\d+)-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      matchDatasources: [
        "docker"
      ],
      matchPackageNames: [
        "ghcr.io/cloudnative-pg/postgis-extension"
      ],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<compatibility>\\d+-\\w+)$"
    },
    // - Disable InfluxDB major releases; keep v1 and v2 separate
    {
      matchDatasources: [
        "docker"
      ],
      matchPackageNames: [
        "docker.io/library/influxdb",
        "influxdb"
      ],
      matchUpdateTypes: [
        "major"
      ],
      enabled: false,
    },
    {
      matchPackageNames: [
        "/cloudflared/"
      ],
      changelogUrl: "https://github.com/cloudflare/cloudflared/blob/master/RELEASE_NOTES"
    },
    {
      matchDatasources: [
        "docker"
      ],
      matchManagers: [
        "helmfile"
      ],
      overrideDepName: "{{packageName}}"
    },
    {
      matchFileNames: [
        ".mise.toml",
        "mise.toml"
      ],
      matchDatasources: [
        "github-releases",
        "github-tags"
      ],
      overridePackageName: "{{#if (lookup (split packageName '/') 1)}}{{packageName}}{{else if (lookup (split packageName ':') 1)}}{{ lookup (split packageName ':') 1 }}/{{ lookup (split packageName ':') 1 }}{{else}}{{packageName}}/{{packageName}}{{/if}}"
    },
    {
      matchDatasources: [
        "docker"
      ],
      matchPackageNames: [
        "ghcr.io/mogenius/helm-charts/renovate-operator"
      ],
      sourceUrl: "https://github.com/mogenius/renovate-operator"
    },
    {
      matchDatasources: [
        "docker"
      ],
      matchPackageNames: [
        "ghcr.io/siderolabs/kubelet"
      ],
      sourceUrl: "https://github.com/kubernetes/kubernetes",
      changelogUrl: "https://github.com/kubernetes/kubernetes/blob/master/CHANGELOG/CHANGELOG-{{newMajor}}.{{newMinor}}.md#v{{newMajor}}{{newMinor}}{{newPatch}}"
    },
    {
      matchDatasources: [
        "docker"
      ],
      matchPackageNames: [
        "ghcr.io/jfroy/samba"
      ],
      changelogUrl: "https://www.samba.org/samba/history/samba-{{newVersion}}.html"
    },
    {
      matchDatasources: [
        "docker"
      ],
      matchPackageNames: [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      changelogUrl: "https://www.postgresql.org/docs/release/{{newMajor}}.{{newMinor}}/"
    },
  ]
}
