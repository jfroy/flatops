{
  "$schema": "https://opencode.ai/config.json",
  "model": "litellm/claude-opus-5",
  "small_model": "litellm/claude-sonnet-5",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "http://litellm.litellm.svc.cluster.local:4000/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      // opencode only auto-populates model metadata for providers it can resolve in the
      // models.dev catalog. "litellm" is a custom provider, so every field below has to be
      // declared by hand — without them the model picker shows no context window, no
      // reasoning flag and text-only inputs. Values mirror the models.dev entries for the
      // upstream models these are proxied to; re-check them when adding or bumping a model
      // in kubernetes/apps/litellm/litellm/app/litellmmodels.yaml.
      "models": {
        "claude-opus-5": {
          "name": "Claude Opus 5",
          "family": "claude-opus",
          "release_date": "2026-07-24",
          "attachment": true,
          "reasoning": true,
          "temperature": false,
          "tool_call": true,
          "limit": { "context": 1000000, "output": 128000 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "cost": { "input": 5, "output": 25, "cache_read": 0.5, "cache_write": 6.25 }
        },
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5",
          "family": "claude-sonnet",
          "release_date": "2026-06-30",
          "attachment": true,
          "reasoning": true,
          "temperature": false,
          "tool_call": true,
          "limit": { "context": 1000000, "output": 128000 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "cost": { "input": 2, "output": 10, "cache_read": 0.2, "cache_write": 2.5 }
        },
        "claude-fable-5": {
          "name": "Claude Fable 5",
          "family": "claude-fable",
          "release_date": "2026-06-09",
          "attachment": true,
          "reasoning": true,
          "temperature": false,
          "tool_call": true,
          "limit": { "context": 1000000, "output": 128000 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "cost": { "input": 10, "output": 50, "cache_read": 1, "cache_write": 12.5 }
        },
        // The GPT-5.6 family prices input above 272k tokens at roughly double the base
        // rate. opencode's cost schema only models a 200k breakpoint, so the base tier is
        // what is declared here and long-context sessions will under-report spend.
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "family": "gpt-sol",
          "release_date": "2026-07-09",
          "attachment": true,
          "reasoning": true,
          "temperature": false,
          "tool_call": true,
          "limit": { "context": 1050000, "input": 922000, "output": 128000 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "cost": { "input": 5, "output": 30, "cache_read": 0.5, "cache_write": 6.25 }
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra",
          "family": "gpt-terra",
          "release_date": "2026-07-09",
          "attachment": true,
          "reasoning": true,
          "temperature": false,
          "tool_call": true,
          "limit": { "context": 1050000, "input": 922000, "output": 128000 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "cost": { "input": 2.5, "output": 15, "cache_read": 0.25, "cache_write": 3.125 }
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "family": "gpt-luna",
          "release_date": "2026-07-09",
          "attachment": true,
          "reasoning": true,
          "temperature": false,
          "tool_call": true,
          "limit": { "context": 1050000, "input": 922000, "output": 128000 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "cost": { "input": 1, "output": 6, "cache_read": 0.1, "cache_write": 1.25 }
        }
      }
    }
  },
  "mcp": {
    "memini": {
      "type": "remote",
      "url": "http://memini.memini.svc.cluster.local:8080/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:MEMINI_API_KEY}"
      }
    }
  }
}
