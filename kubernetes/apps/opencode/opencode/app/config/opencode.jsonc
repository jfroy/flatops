{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-opus-5",
  "small_model": "anthropic/claude-sonnet-5",
  "provider": {
    "anthropic": {
      "name": "Anthropic (LiteLLM)",
      "options": {
        "baseURL": "http://litellm.litellm.svc.cluster.local:4000/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "whitelist": ["claude-opus-5", "claude-sonnet-5", "claude-fable-5"]
    },
    "openai": {
      "name": "OpenAI (LiteLLM)",
      "options": {
        "baseURL": "http://litellm.litellm.svc.cluster.local:4000/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "whitelist": ["gpt-5.6-sol", "gpt-5.6-terra", "gpt-5.6-luna"]
    }
  },
  "mcp": {
    "memini": {
      "type": "remote",
      "url": "http://memini.memini.svc.cluster.local:8080/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:MEMINI_API_KEY}"
      }
    }
  }
}
